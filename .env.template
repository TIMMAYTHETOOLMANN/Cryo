# === Profit & Risk Configuration ===
# Minimum net profit in wei before executing (default: 0.01 ETH)
MIN_PROFIT_WEI=10000000000000000
# Minimum net profit in USD
MIN_PROFIT_USD=50
# Maximum gas price in gwei — skip execution above this threshold
GAS_PRICE_CAP_GWEI=50
# Gas estimation buffer multiplier (1.2 = 20% buffer)
GAS_LIMIT_BUFFER=1.2
# Maximum gas limit per transaction
MAX_GAS_LIMIT=1000000
# Health factor below which positions are flagged as liquidatable (default 1.05)
HEALTH_FACTOR_THRESHOLD=1.05
# Minimum USD debt size to consider for liquidation
MIN_DEBT_USD=1000
# Transaction broadcast timeout in seconds
TRANSACTION_TIMEOUT_SECONDS=120

# === Live Execution Gate ===
# CRITICAL: Set to true ONLY when you are ready for live mainnet transaction submission.
# When false (the default), the system operates in scan-only mode — all opportunities
# are detected and logged but NO transactions are submitted to the network.
# This is the final safety catch before real money is spent.
EXECUTION_ENABLED=false

# === Watchlist / Scanner Scaling ===
# Maximum positions to track in the active watchlist (sorted by lowest HF first).
# Increase to improve liquidation capture probability; decrease on low-tier RPC plans.
MAX_WATCHLIST_SIZE=500

# === Scanner Configuration ===
# Scan cycle interval in seconds (default: 300 = 5 minutes)
SCAN_INTERVAL=300
# Scan interval for the fast liquidation detector in seconds (default: 3)
SCAN_INTERVAL_SECONDS=3
# Forge verbosity level (-v, -vv, -vvv, -vvvv)
VERBOSITY=-vvv

# === Contract Verification ===
# Set VERIFY_ETHERSCAN=true to verify contracts after deployment
VERIFY_ETHERSCAN=false
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
SNOWTRACE_API_KEY=
BSCSCAN_API_KEY=

# === TimescaleDB (Position Snapshots) ===
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=ocds
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=
TIMESCALE_SSL_MODE=disable

# === Redis (Caching / Rate-Limiting) ===
REDIS_URL=redis://localhost:6379/0

# === Alert Routing ===
# Telegram — CRITICAL and WARNING alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord — INFO and DETECTION alerts
DISCORD_WEBHOOK_URL=

# PagerDuty — CRITICAL (HF < 1.05) alerts
PAGERDUTY_INTEGRATION_KEY=

