# Ethereum Mainnet RPC URL (Alchemy, Infura, or QuickNode recommended)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private key for the executing wallet (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Minimum profit threshold in wei (default: 0.01 ETH)
MIN_PROFIT_WEI=10000000000000000

# Gas price cap in gwei (to avoid overpaying during congestion)
GAS_PRICE_CAP_GWEI=50

# Polling interval in seconds (how often to check for opportunity)
POLL_INTERVAL=300

# Dry run mode (set to "true" to simulate without broadcasting transactions)
DRY_RUN=false

# Forge verbosity level (e.g., -v, -vv, -vvv, -vvvv)
VERBOSITY=-vvv
