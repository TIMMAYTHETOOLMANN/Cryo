# === OCDS Multi-Chain RPC Configuration ===
# Primary RPC endpoints (Alchemy recommended for production)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
AVALANCHE_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ZKSYNC_RPC_URL=https://zksync-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# === Execution Configuration ===
# Private key for the executing wallet (without 0x prefix)
# Leave empty for scan-only mode (no transactions submitted)
PRIVATE_KEY=

# Minimum profit threshold in wei (default: 0.01 ETH)
MIN_PROFIT_WEI=10000000000000000

# Gas price cap in gwei (to avoid overpaying during congestion)
GAS_PRICE_CAP_GWEI=50

# === Scanner Configuration ===
# Scan interval in seconds (how often to run detection cycle)
SCAN_INTERVAL=300

# Forge verbosity level (e.g., -v, -vv, -vvv, -vvvv)
VERBOSITY=-vvv
